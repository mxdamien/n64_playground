{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Project with Make",
      "type": "shell",
      "command": "make",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Runs the make command to build the project"
    }
  ]
}